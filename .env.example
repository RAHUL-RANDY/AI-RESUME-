# AI Career Intelligence Platform - Environment Variables

# Database Configuration
# Supabase (PostgreSQL - Recommended for Production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
POSTGRES_HOST=db.ddvvtzeyrntegbclnhoo.supabase.co
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password

# MongoDB Connection (Alternative / Secondary)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=career_intelligence

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_career_intelligence_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Optional - high-quality contextual NLP fallback used if not provided)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Server & CORS
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ENVIRONMENT=development
